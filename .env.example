# Copy this file to .env and fill in real values. .env is ignored by Git.
# Format is java.util.Properties: KEY=value, no quotes, no `export`, one per line.

# ---- Required ----

# MongoDB Atlas connection string. Use a dedicated demo/test cluster.
# Example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=MandateShield

# JWT signing key. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# The backend refuses to start without it.
MANDATESHIELD_JWT_SECRET=

# ---- Optional: Gemini enrichment ----
# GOOGLE_GENAI_API_KEY=
# MANDATESHIELD_CHAT_MODEL=google-genai
# MANDATESHIELD_GEMINI_MODEL=gemini-3.8-flash

# ---- Optional: Pinecone merchant vectors ----
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=mandateshield-merchants
# PINECONE_INDEX_HOST=
